' harmless Roblox fake error + rickroll hehe

MsgBox "An unexpected error occurred and Roblox needs to quit. We're sorry!", vbOKOnly, "Roblox Crash"

' base64 rickroll audio (short version or sample)
' put your base64 audio data here ↓
Dim base64Audio
base64Audio = ""

' decode base64 into a temporary mp3 file and play it
Dim xml, stream, tempPath, tempFile
Set xml = CreateObject("MSXML2.DOMDocument")
Set stream = CreateObject("ADODB.Stream")

tempPath = CreateObject("Scripting.FileSystemObject").GetSpecialFolder(2) ' temp folder
tempFile = tempPath & "\rickroll.mp3"

' decode base64
Set xml = CreateObject("MSXML2.DOMDocument.6.0")
Set node = xml.createElement("b64")
node.DataType = "bin.base64"
node.Text = base64Audio

Set stream = CreateObject("ADODB.Stream")
stream.Type = 1 ' binary
stream.Open
stream.Write node.nodeTypedValue
stream.SaveToFile tempFile, 2
stream.Close

' play the sound (using Windows Media Player)
Set player = CreateObject("WMPlayer.OCX")
player.URL = tempFile
player.Controls.play

' wait while playing (approx 20 sec)
WScript.Sleep 11000